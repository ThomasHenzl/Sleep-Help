{
  "tips": [
    {
      "id": 1,
      "category": "schlafhygiene",
      "title": "Regelmäßige Schlafzeiten",
      "description": "Geh jeden Tag zur gleichen Zeit ins Bett und steh zur gleichen Zeit auf – auch am Wochenende.",
      "priority": "hoch"
    },
    {
      "id": 2,
      "category": "schlafhygiene",
      "title": "Bildschirmzeit reduzieren",
      "description": "Vermeide Smartphone, Tablet und Laptop mindestens 60 Minuten vor dem Schlafen.",
      "priority": "hoch"
    },
    {
      "id": 3,
      "category": "ernaehrung",
      "title": "Kein Koffein am Abend",
      "description": "Ab 14 Uhr kein Kaffee, Cola oder Energydrinks. Koffein hat eine Halbwertszeit von 5–6 Stunden.",
      "priority": "mittel"
    },
    {
      "id": 4,
      "category": "umgebung",
      "title": "Kühle Raumtemperatur",
      "description": "Die ideale Schlaftemperatur liegt bei 16–18 °C. Ein eher kühles Schlafzimmer fördert das Einschlafen.",
      "priority": "hoch"
    },
    {
      "id": 5,
      "category": "umgebung",
      "title": "Dunkelheit im Schlafzimmer",
      "description": "Verdunkelungsvorhänge oder eine Schlafmaske helfen, die Melatonin-Produktion zu unterstützen.",
      "priority": "mittel"
    },
    {
      "id": 6,
      "category": "entspannung",
      "title": "4-7-8 Atemtechnik",
      "description": "4 Sek. einatmen, 7 Sek. halten, 8 Sek. ausatmen. Beruhigt das Nervensystem und fördert das Einschlafen.",
      "priority": "mittel"
    },
    {
      "id": 7,
      "category": "entspannung",
      "title": "Progressive Muskelentspannung",
      "description": "Spanne und löse jede Muskelgruppe von den Füßen bis zum Kopf für jeweils 5–10 Sekunden.",
      "priority": "niedrig"
    },
    {
      "id": 8,
      "category": "bewegung",
      "title": "Tägliche Bewegung",
      "description": "30 Minuten moderate Bewegung am Tag verbessern die Schlafqualität, aber nicht direkt vor dem Schlafen.",
      "priority": "mittel"
    }
  ],
